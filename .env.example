# Nebius Token Factory API key (https://tokenfactory.nebius.com)
# Never commit a real key. Set it in your deployment platform's
# environment variables instead.
NEBIUS_API_KEY=

# NVIDIA open model served on Token Factory.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily API key (https://app.tavily.com), used for web search and page
# extraction. Without it the agent drafts from the model alone and flags the
# quote as unverified.
TAVILY_API_KEY=
