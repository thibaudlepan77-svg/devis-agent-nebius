# Nebius Token Factory API key (https://tokenfactory.nebius.com)
# Never commit the real key. Set this in your deployment platform's
# environment variables instead.
NEBIUS_API_KEY=

# NVIDIA open source model served on Token Factory, e.g. an NVIDIA Nemotron model.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
